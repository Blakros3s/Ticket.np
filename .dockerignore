# Docker build context is the repo root (context: ..). Exclude caches and artifacts
# so Windows bind mounts / locked folders do not slow or break `docker build`.

# Git & editor
.git
.gitignore
.cursor
.vscode
.idea

# Docs / design (not needed in images)
docs
design
**/*.md
!frontend/README.md

# Python / Django (backend)
backend/.venv
backend/venv
backend/.pytest_cache
backend/.ruff_cache
backend/.mypy_cache
backend/**/__pycache__
backend/**/*.py[cod]
backend/staticfiles
backend/media

# Node / Next.js (frontend — still excluded when backend context is repo root)
frontend/node_modules
frontend/.next
frontend/out
frontend/dist
frontend/.turbo
frontend/**/*.tsbuildinfo

# Secrets (never send to daemon)
**/.env
**/.env.*
!**/.env.example

# OS
.DS_Store
Thumbs.db
*.swp
