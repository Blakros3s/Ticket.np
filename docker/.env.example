# ==============================================================================
# Docker Compose environment (copy to docker/.env)
#
# Used by docker-compose.base.yml + docker-compose.dev.yml / docker-compose.prod.yml
# for variable substitution (${VAR}). Compose loads this file when you run
# commands from the docker/ directory.
#
#   cp .env.example .env
#
# You still need app-level env files (not replaced by this file):
#   Dev:  ../backend/.env          (copy from ../backend/.env.example)
#         ../frontend/.env.local    (copy from ../frontend/.env.example)
#   Prod: ../backend/.env.prod
#         ../frontend/.env.production
#
# Dev:
#   docker compose -f docker-compose.base.yml -f docker-compose.dev.yml up -d --build
#
# Prod:
#   docker compose -f docker-compose.base.yml -f docker-compose.prod.yml up -d --build
# ==============================================================================

# Project name prefix for containers, images, and volumes (ticketnp_db, etc.)
COMPOSE_PROJECT_NAME=ticketnp

# PostgreSQL (docker-compose.base.yml — shared by db, backend, celery)
POSTGRES_DB=tickethub
POSTGRES_USER=tickethub
POSTGRES_PASSWORD=tickethub_password

# Host ports published to your machine (127.0.0.1 only in compose overlays)
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Baked into the frontend image at build time and passed to the frontend container.
# Must be reachable from the user's browser (not the Docker internal hostname "backend").
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# --- Production example (adjust host ports and public API URL) ---
# BACKEND_PORT=8009
# FRONTEND_PORT=3009
# NEXT_PUBLIC_API_URL=https://login.example.com/api
